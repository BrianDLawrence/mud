# Use an Atlas connection string in deployed environments.
# Local development falls back to an intentionally non-durable in-memory store.
MONGODB_URI=
MONGODB_DATABASE=nextmud

# Better Auth requires a high-entropy secret of at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Create an OAuth application at https://discord.com/developers/applications
# Local callback: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# This is the same public value as DISCORD_CLIENT_ID. Next.js embeds it in the
# browser bundle so the Discord Embedded App SDK can initialize.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
